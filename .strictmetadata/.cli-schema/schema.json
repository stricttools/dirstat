      "short": null,
      "env": null,
      "env_separator": null,
      "prefixed": true,
      "choices": null,
      "elect_by": null,
      "unique": false,
      "conflict_mode": null,
      "negatable": null,
      "nullable": false
    },
    "arg": {
      "variadic": false,
      "choices": null
    },
    "choice": {
      "flags": []
    },
    "choice_record": {
      "help": null
    },
    "command": {
      "consequential": false,
      "dry_run_supported": true,
      "dry_run_unsupported_reason": null,
      "update_of": null,
      "write_mode": null,
      "payload_schema": null,
      "owns_stdout": false,
      "passthrough": false,
      "flags": [],
      "flag_sets": [],
      "args": [],
      "tags": [],
      "constraints": [],
      "hidden": false,
      "interactive": false,
      "config_fields": [],
      "grants": [],
      "forwarding": null
    },
    "group": {
      "commands": {},
      "groups": {},
      "deprecated": {},
      "tags": [],
