{
  "schema_version": 2,
  "defaults": {
    "schema_version": 2,
    "app": {
      "env_prefix": null,
      "config": false,
      "config_format": "json",
      "config_path": null,
      "config_conflict_mode": "cli-wins",
      "proc_observe_allowlist": [],
      "global_flags": [],
      "commands": {},
