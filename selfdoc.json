{
  "version": "0.6.2",
  "description": "Fast, single-binary directory statistics CLI: every file under a tree grouped by format, with counts, sizes, and lines of code, as a colored terminal table or as JSON",
  "source": [
    {
      "path": ".",
      "language": "go"
    },
    {
      "path": "internal/classify",
      "language": "go"
    },
    {
      "path": "internal/config",
      "language": "go"
    },
    {
      "path": "internal/jsonout",
      "language": "go"
    },
    {
      "path": "internal/render",
      "language": "go"
    },
    {
      "path": "internal/scan",
      "language": "go"
    }
  ],
  "docs": "stricttools/docs/",
  "output": "stricttools/.docs-cache/build/",
  "base_url": "https://smmh.dev/dirstat",
  "root_files": [
    "stricttools/docs/_README.md",
    "stricttools/docs/_CLAUDE.md"
  ],
  "directives": {
    "table-default-excludes": "stricttools/docs/_directives/default_excludes.py",
    "table-text-extensions": "stricttools/docs/_directives/text_extensions.py"
  },
  "search_engine": "pagefind",
  "author": {
    "name": "SMMH",
    "url": "https://smmh.dev",
    "same_as": [
      "https://github.com/smm-h"
    ]
  },
  "versions": [
    {
      "version": "0.6.2"
    }
  ],
  "locales": [
    {
      "code": "en",
      "label": "English",
      "default": true
    }
  ],
  "repo": "https://github.com/stricttools/dirstat",
  "topology": {
    "slug": "dirstat",
    "docs_base": "https://smmh.dev",
    "posts_base": "https://smmh.dev/blog"
  },
  "assembly": {
    "repo": "smm-h/selfdoc-cache",
    "pages_project": "smmh"
  }
}
